{
  "info": {
    "name": "Kraviona Backend API",
    "description": "Complete API collection for Kraviona CMS Backend",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/auth/create-account",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "create-account"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"John Doe\", \"email\": \"john@example.com\", \"username\": \"johndoe\", \"phone\": \"+91234567890\", \"password\": \"SecurePass@123\"}"
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/auth/verify-account",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "verify-account"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"john@example.com\", \"otp\": \"123456\"}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/auth/login-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"john@example.com\", \"password\": \"SecurePass@123\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/posts?page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "posts"]
            }
          }
        },
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ACCESS_TOKEN"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/post/create",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "post", "create"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"My First Post\", \"content\": \"Content here...\", \"excerpt\": \"Short excerpt\", \"categoryID\": \"category_id_here\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/categories/public",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "categories", "public"]
            }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ACCESS_TOKEN"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/category/new",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "category", "new"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Technology\", \"description\": \"Tech posts\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Newsletter",
      "item": [
        {
          "name": "Subscribe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/subscriber/new",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "subscriber", "new"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"subscriber@example.com\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/client/send-message",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "client", "send-message"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"John\", \"email\": \"john@example.com\", \"subject\": \"Inquiry\", \"message\": \"Hello...\"}"
            }
          }
        }
      ]
    }
  ]
}
